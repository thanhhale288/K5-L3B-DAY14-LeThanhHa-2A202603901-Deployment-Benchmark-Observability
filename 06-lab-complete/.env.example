# ============================================================
# Mẫu biến môi trường. Dùng:  cp .env.example .env
# File .env (giá trị thật) đã nằm trong .gitignore — KHÔNG commit.
# File này chỉ chứa TÊN biến và giá trị ví dụ, không có secret thật.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development

# Bảo mật: key client phải gửi trong header X-API-Key (đặt giá trị thật trong .env hoặc trên cloud)
AGENT_API_KEY=change-me

# Redis (rate limit, cost guard). Trong docker compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn: số request / phút cho mỗi API key; ngân sách LLM tối đa mỗi ngày (USD)
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
